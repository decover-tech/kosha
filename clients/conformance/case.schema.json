{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/decover-tech/kosha/clients/conformance/case.schema.json",
  "title": "Kosha SDK conformance case file",
  "description": "A file in cases/ is an array of cases. Every runner (Python, TypeScript, Go) implements every op and matcher below; an unknown op or matcher fails the run. See README.md for what each op returns.",
  "type": "array",
  "items": { "$ref": "#/$defs/case" },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "covers", "steps"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z]+\\.[a-z0-9_]+$" },
        "description": { "type": "string" },
        "covers": {
          "description": "Public operationIds of api/openapi/v1/kosha.openapi.json this case exercises (check_coverage.py).",
          "type": "array",
          "items": { "type": "string", "pattern": "^KoshaService_[A-Za-z]+$" }
        },
        "tenant": {
          "description": "Which API key the case uses: default (KOSHA_CONFORMANCE_API_KEY), small (max_body_bytes 4096), limited (qps 1), or invalid (an unknown key).",
          "enum": ["default", "small", "limited", "invalid"]
        },
        "setup": { "type": "array", "items": { "$ref": "#/$defs/setupStep" } },
        "faults": {
          "description": "Rules installed in faultproxy.py for this case's steps (not its setup). A case with faults, or with an attempts matcher, needs KOSHA_CONFORMANCE_CONTROL and is skipped without it.",
          "type": "array",
          "items": { "$ref": "#/$defs/fault" }
        },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } }
      }
    },
    "op": {
      "enum": [
        "create_namespace",
        "list_namespaces",
        "delete_namespace",
        "put_schema",
        "get_schema",
        "upsert",
        "merge",
        "exists",
        "search",
        "search_all",
        "bulk_index",
        "delete_by_query",
        "flush",
        "stats",
        "raw_request"
      ]
    },
    "client": {
      "description": "Client settings for this step only; the runner builds a client with them.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout_ms": { "type": "integer", "minimum": 1 },
        "max_attempts": { "type": "integer", "minimum": 1 },
        "total_budget_ms": { "type": "integer", "minimum": 1 },
        "retry_non_idempotent": { "type": "boolean" }
      }
    },
    "setupStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op"],
      "properties": {
        "op": { "$ref": "#/$defs/op" },
        "args": { "type": "object" }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op"],
      "properties": {
        "op": { "$ref": "#/$defs/op" },
        "args": {
          "description": "Op arguments. In every string, \"$NS\" is the case's namespace and \"$BIG\" 5000 x characters (expect gets the same substitution). namespace defaults to \"$NS\". documents may be a generator: {\"generate\": {...}}.",
          "type": "object"
        },
        "client": { "$ref": "#/$defs/client" },
        "expect": { "$ref": "#/$defs/expect" }
      }
    },
    "generate": {
      "description": "count documents; in id and every field value, {i} is the index, {i:0W} zero-padded to W digits, {i%N} the index mod N, {i%N:0W} both.",
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "id"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "id": { "type": "string" },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "value"],
            "properties": { "type": { "type": "string" }, "value": { "type": "string" } }
          }
        }
      }
    },
    "expect": {
      "description": "Matchers. Without an error matcher the op must succeed.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ok": { "const": true },
        "ids": {
          "description": "The result's ids, in order; or a generator whose ids they must equal.",
          "oneOf": [
            { "type": "array", "items": { "type": "string" } },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["generate"],
              "properties": { "generate": { "$ref": "#/$defs/generate" } }
            }
          ]
        },
        "ids_unordered": { "type": "array", "items": { "type": "string" } },
        "ids_include": { "type": "array", "items": { "type": "string" } },
        "total_hits": { "type": "integer" },
        "count": { "type": "integer" },
        "unique": { "const": true },
        "indexed": { "type": "integer" },
        "batches": { "type": "integer" },
        "failed_ids": { "type": "array", "items": { "type": "string" } },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["http", "transport", "config"] },
            "status": { "type": "integer" },
            "code": { "type": "string" },
            "retryable": { "type": "boolean" },
            "has_request_id": { "type": "boolean" },
            "retry_after_ms": { "type": "integer" }
          }
        },
        "attempts": { "description": "Requests faultproxy saw for this step.", "type": "integer" },
        "attempts_min": { "type": "integer" },
        "min_elapsed_ms": { "type": "integer" },
        "max_elapsed_ms": { "type": "integer" }
      }
    },
    "fault": {
      "type": "object",
      "additionalProperties": false,
      "required": ["match"],
      "properties": {
        "match": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "method": { "type": "string" },
            "path_suffix": { "type": "string" },
            "step": { "type": "integer", "minimum": 0 }
          }
        },
        "times": { "description": "How many matching requests the rule applies to (default: all).", "type": "integer", "minimum": 1 },
        "respond": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "type": "integer" },
            "headers": { "type": "object", "additionalProperties": { "type": "string" } },
            "body": {}
          }
        },
        "delay_ms": { "description": "Wait, then forward the request.", "type": "integer", "minimum": 0 },
        "inject_field": { "description": "Forward, then merge these keys into the JSON response.", "type": "object" }
      }
    }
  }
}
