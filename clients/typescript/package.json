{
  "name": "@decover/kosha",
  "version": "0.1.0",
  "description": "TypeScript client for the Kosha search engine's /v1 HTTP API",
  "license": "Apache-2.0",
  "author": "DecoverAI <engineering@decoverai.com>",
  "homepage": "https://github.com/decover-tech/kosha/tree/main/clients/typescript",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/decover-tech/kosha.git",
    "directory": "clients/typescript"
  },
  "bugs": "https://github.com/decover-tech/kosha/issues",
  "keywords": ["kosha", "search", "bm25", "vector", "client"],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "gen": "openapi-typescript ../../api/openapi/v1/kosha.openapi.json --empty-objects-unknown -o src/generated/schema.ts && node scripts/stamp-generated.mjs src/generated/schema.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "build": "node scripts/clean.mjs dist && tsc -p tsconfig.build.json",
    "test": "vitest run --exclude test/conformance.test.ts",
    "test:conformance": "vitest run test/conformance.test.ts",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "openapi-typescript": "7.10.1",
    "publint": "0.3.15",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
