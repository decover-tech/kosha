# Rust build artifacts. Cargo.lock is intentionally committed: this workspace
# ships a binary and the lockfile is the reproducible-build contract.
/target
**/*.rs.bk

# OS / editor noise
.DS_Store
.idea/
.vscode/
*.swp

# Python bytecode
**/__pycache__/
*.pyc
*.egg-info

# Generated code (can be regenerated from proto)
/gen

# Python build artifacts
**/dist/

# Local dev volumes (docker-compose)
/volumes

# Local benchmark output (scripts/bench/compare/run_local.sh)
/scripts/bench/compare/out/

# OpenAPI generation scratch and the pinned API tool binaries (make openapi)
/build
